include osxphotos/*.json
include osxphotos/*.md
include osxphotos/phototemplate.tx
include osxphotos/queries/*
include osxphotos/templates/*
include osxphotos/lib/libdisclaim.dylib
include osxphotos/lib/libdisclaim_arm64.dylib
include osxphotos/lib/libdisclaim_x86_64.dylib
